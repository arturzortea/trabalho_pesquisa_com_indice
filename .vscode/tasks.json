{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar (gcc)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g", "-Wall", "-Wextra", "-O2",
                "main.c", "tabela.c", "modelos.c", "consultas.c",
                "-o", "trabalho1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
